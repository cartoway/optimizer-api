<!DOCTYPE html>
<html>

<head>
  <meta charset="UTF-8">
  <title>Optimizer</title>
  <link rel="stylesheet" href="css/style.css">
</head>

<body>
  <div class="block">
    <h1>Optimizer</h1>
  </div>
  <div class="block">
    <fieldset id="optim-list-status">
      <legend id="optim-list-legend"></legend>
      <div id="jobs-filters" class="jobs-filters" hidden></div>
      <div id="jobs-list">
      </div>
    </fieldset>
  </div>
  <section id="plan-compare" class="compare">
    <header class="compare-header">
      <div>
        <h2 id="compare-title">Comparaison des résolutions</h2>
        <p id="compare-help">Choisissez la référence, puis comparez les écarts colorés sous chaque indicateur.</p>
      </div>
      <form id="compare-add" autocomplete="off">
        <input id="compare-job-id" list="compare-job-ids" placeholder="Ajouter un VRP…">
        <datalist id="compare-job-ids"></datalist>
        <button id="compare-submit" type="submit">Ajouter</button>
      </form>
    </header>
    <p id="compare-error" class="error" hidden></p>
    <div id="compare-table-wrap"></div>
  </section>
  <form id="post-form" class="panel-form" autocomplete="off">
    <!-- <a id="doc-link" href="#documentation">documentation</a> -->
    <div class="panel-form-row">
      <label id="file-customers-label" for="json-file"><%= I18n.t('views.shared.file_problem_label') %></label>
      <input type="file" id="json-file" value="">
    </div>
    <div class="panel-form-row">
      <button type="submit" id="send-files" class="job-action job-action-primary"><%= I18n.t('views.shared.send') %></button>
      <span id="files-infos"></span>
    </div>
  </form>
  <div class="block result-panel">
    <canvas id="result-graph"></canvas>
    <div class="result-toolbar"><span id="result-label"></span> <span id="optim-infos"></span></div>
    <textarea id="result"></textarea>
  </div>

  <script src="https://unpkg.com/i18next@21.6.6/dist/umd/i18next.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/i18next-browser-languagedetector/6.0.0/i18nextBrowserLanguageDetector.min.js"></script>
  <script src="js/translations.js?v=20261005e"></script>
  <script src="js/jquery-1.12.3.min.js"></script>
  <script src="js/papaparse.min.js"></script>
  <script src="js/Chart.Core.min.js"></script>
  <script src="js/Chart.Scatter.min.js"></script>
  <script src="js/conf.js?v=20220121"></script>
  <script src="js/utils.js?v=20261005g"></script>
  <script src="js/jobManager.js?v=20261005e"></script>
  <script src="js/compare.js?v=20261005e"></script>
  <script src="js/index.js?v=20261005g"></script>
</body>
</html>
